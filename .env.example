# Copy to .env and edit. Never commit .env.
VILLAGE_DEVICE_MODE=simulator          # simulator | real
VILLAGE_DEVICE_URL=http://192.168.1.50 # ESP32 IP when mode=real
VILLAGE_DEVICE_TOKEN=dev-village-token-change-me
VILLAGE_DEVICE_TIMEOUT_SECS=3
VILLAGE_POLL_INTERVAL_MS=1000
VILLAGE_STALE_AFTER_MS=4000
VILLAGE_DISCONNECT_AFTER_MS=9000
VILLAGE_WHISPER_URL=http://127.0.0.1:8181
# Any multilingual ggml model: ggml-base.bin, ggml-small.bin,
# ggml-medium.bin, ggml-large-v3.bin or ggml-large-v3-turbo.bin.
# English-only *.en.bin files are refused.
VILLAGE_WHISPER_MODEL=models/whisper/ggml-base.bin
# Threads whisper.cpp may use; defaults to the core count.
# VILLAGE_WHISPER_THREADS=8
VILLAGE_WHISPER_TIMEOUT_SECS=90
# Spoken replies use a local neural voice (Piper). Install it with
# ./scripts/install_piper.sh; the defaults below are what that script writes.
# VILLAGE_PIPER_BIN=models/piper/piper
# VILLAGE_PIPER_VOICES=models/piper/voices
# VILLAGE_PIPER_CACHE=data/cache/tts
VILLAGE_DB_PATH=data/village.db
VILLAGE_BIND_HOST=127.0.0.1
VILLAGE_PORT=8010
VILLAGE_POLL_ENABLED=true
VILLAGE_SAMPLE_LOOP=true

# Optional overrides
# VILLAGE_VENV=/path/to/venv
# VILLAGE_WHISPER_BIN=/path/to/whisper-server
# VILLAGE_DIST_DIR=/path/to/dist
