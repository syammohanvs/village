# Copy to .env and edit. Never commit .env.

# Sign-in for the dashboard. The gate exists so a visitor cannot press Water or
# change the calibration on a screen nobody is watching; it locks the screen,
# not the village (the board, the camera and the pump keep running).
VILLAGE_AUTH_ENABLED=true
VILLAGE_ADMIN_USER=admin
# Change this before the exhibit is public. The start-up log warns while the
# built-in default is in use.
VILLAGE_ADMIN_PASSWORD=village
# Optional: a pre-hashed password ("pbkdf2$...") instead of the plaintext above.
# VILLAGE_ADMIN_PASSWORD_HASH=
# How long one sign-in lasts. 12 hours means a fresh laptop asks once a day.
VILLAGE_SESSION_HOURS=12

VILLAGE_DEVICE_MODE=simulator          # simulator | real
# Every crop the camera sends is kept here, so a misread can be looked at
# afterwards (the filename carries the time, the class and the confidence).
# Set it to an empty value to switch it off; VILLAGE_WASTE_CAPTURE_KEEP
# bounds how many are kept (oldest deleted first).
VILLAGE_WASTE_CAPTURE_DIR=data/waste-captures
VILLAGE_WASTE_CAPTURE_KEEP=20000

VILLAGE_DEVICE_URL=http://192.168.1.50 # ESP32 IP when mode=real
VILLAGE_DEVICE_TOKEN=dev-village-token-change-me
VILLAGE_DEVICE_TIMEOUT_SECS=3
# The board's address is DHCP and it moves.  When the configured URL stops
# answering, sweep its /24 for a host that answers /api/v1/status with the
# device token, and use that.  0/false turns the sweep off.
VILLAGE_DEVICE_DISCOVER=true
VILLAGE_DEVICE_DISCOVER_SECS=60
VILLAGE_POLL_INTERVAL_MS=1000
VILLAGE_STALE_AFTER_MS=4000
VILLAGE_DISCONNECT_AFTER_MS=9000
VILLAGE_WHISPER_URL=http://127.0.0.1:8181
# Any multilingual ggml model: ggml-base.bin, ggml-small.bin,
# ggml-medium.bin, ggml-large-v3.bin or ggml-large-v3-turbo.bin.
# English-only *.en.bin files are refused.
VILLAGE_WHISPER_MODEL=models/whisper/ggml-base.bin
# Threads whisper.cpp may use; defaults to the core count.
# VILLAGE_WHISPER_THREADS=8
VILLAGE_WHISPER_TIMEOUT_SECS=90
# Malayalam is read by a Whisper-small fine-tuned on Malayalam, not by the
# multilingual model above (that one hears the words but writes them in Tamil
# letters).  scripts/download_models.sh fetches it (~950 MB).  Unset, it lives at
# models/whisper/ml-asr; point it elsewhere, or at a directory that does not
# exist to fall back to whisper.cpp for Malayalam too.
# VILLAGE_ML_ASR_DIR=models/whisper/ml-asr
# Spoken replies use a local neural voice (Piper). Install it with
# ./scripts/install_piper.sh; the defaults below are what that script writes.
# VILLAGE_PIPER_BIN=models/piper/piper
# VILLAGE_PIPER_VOICES=models/piper/voices
# VILLAGE_PIPER_CACHE=data/cache/tts
VILLAGE_DB_PATH=data/village.db
VILLAGE_BIND_HOST=127.0.0.1
VILLAGE_PORT=8010
VILLAGE_POLL_ENABLED=true
VILLAGE_SAMPLE_LOOP=true

# Optional overrides
# VILLAGE_VENV=/path/to/venv
# VILLAGE_WHISPER_BIN=/path/to/whisper-server
# VILLAGE_DIST_DIR=/path/to/dist
