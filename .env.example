# Copy to .env and edit. Never commit .env.

# Sign-in for the dashboard. The gate exists so a visitor cannot press Water or
# change the calibration on a screen nobody is watching; it locks the screen,
# not the village (the board, the camera and the pump keep running).
VILLAGE_AUTH_ENABLED=true
# Single-quote a name that contains '$': the shell and python-dotenv would
# otherwise read the rest of it as a variable.
VILLAGE_ADMIN_USER=admin
# Change this before the exhibit is public. The start-up log warns while the
# built-in default is in use.
VILLAGE_ADMIN_PASSWORD=village
# Optional: a pre-hashed password ("pbkdf2$...") instead of the plaintext above.
# VILLAGE_ADMIN_PASSWORD_HASH=
# How long one sign-in lasts. 12 hours means a fresh laptop asks once a day.
VILLAGE_SESSION_HOURS=12

# The share link: a visit link that signs in as `guest` and can only use
# Simulation.  Setup shows the link itself (its key is kept in village.db and
# "New link" replaces it).  `0` removes the route entirely.
VILLAGE_SHARE_LINK=1

# Which other origins may call this API from a browser, comma-separated.
# `https://*.pages.dev` (the hosted copy of this dashboard) is allowed by
# default; add your own site if it has a custom domain.  A `*` makes the entry
# a pattern.  `http://localhost:5173` is the Vite dev server.
# VILLAGE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://village.pages.dev

VILLAGE_DEVICE_MODE=simulator          # simulator | real
# Every crop the camera sends is kept here, so a misread can be looked at
# afterwards (the filename carries the time, the class and the confidence).
# Set it to an empty value to switch it off; VILLAGE_WASTE_CAPTURE_KEEP
# bounds how many are kept (oldest deleted first).
VILLAGE_WASTE_CAPTURE_DIR=data/waste-captures
VILLAGE_WASTE_CAPTURE_KEEP=20000
# Keeping every judged crop is a *training* decision, so it is off unless you
# turn it on: a visitor's press should not silently write a picture to disk.
# Turn it on for a session you mean to learn from, then look at the Data page.
VILLAGE_WASTE_SAVE_CROPS=false

VILLAGE_DEVICE_URL=http://192.168.1.50 # ESP32 IP when mode=real
VILLAGE_DEVICE_TOKEN=dev-village-token-change-me
VILLAGE_DEVICE_TIMEOUT_SECS=3
# The board's address is DHCP and it moves.  When the configured URL stops
# answering, sweep its /24 for a host that answers /api/v1/status with the
# device token, and use that.  0/false turns the sweep off.
VILLAGE_DEVICE_DISCOVER=true
VILLAGE_DEVICE_DISCOVER_SECS=60
VILLAGE_POLL_INTERVAL_MS=1000
VILLAGE_STALE_AFTER_MS=4000
VILLAGE_DISCONNECT_AFTER_MS=9000
VILLAGE_WHISPER_URL=http://127.0.0.1:8181
# Any multilingual ggml model: ggml-base.bin, ggml-small.bin,
# ggml-medium.bin, ggml-large-v3.bin or ggml-large-v3-turbo.bin.
# English-only *.en.bin files are refused.
VILLAGE_WHISPER_MODEL=models/whisper/ggml-base.bin
# Threads whisper.cpp may use; defaults to the core count.
# VILLAGE_WHISPER_THREADS=8
VILLAGE_WHISPER_TIMEOUT_SECS=90
# The last few voice recordings, kept on disk so a sentence the exhibit got
# wrong can be listened to and re-run (`./scripts/voice_replay.py`).  Bounded by
# BOTH a count and a total size, and pruned on every recording, so it cannot
# fill the disk: 100 clips of at most 12 s is about 32 MB.  A clip carries a
# .json beside it with what it produced (language, engine, transcript, intent).
#   VILLAGE_VOICE_CLIPS=0            keep none
#   VILLAGE_VOICE_CLIP_DIR=          switch it off by naming no directory
# VILLAGE_VOICE_CLIPS=100
# VILLAGE_VOICE_CLIP_BYTES=67108864
# Frontend (Vite) build-time variables.  Set these in the Cloudflare Pages
# dashboard (Settings -> Environment variables) to point a shared build at
# a backend that is not on the same host.  They are baked into the bundle
# at build time; the built SPA also reads `village.apiBase` from
# localStorage at runtime, which the login screen can set from
# `?api=https://...`.
# VITE_API_BASE_URL=https://your-village.example.com
# VITE_LAYOUT=kiosk
# Malayalam is read by a Whisper-small fine-tuned on Malayalam, not by the
# multilingual model above (that one hears the words but writes them in Tamil
# letters).  scripts/download_models.sh fetches it (~950 MB).  Unset, it lives at
# models/whisper/ml-asr; point it elsewhere, or at a directory that does not
# exist to fall back to whisper.cpp for Malayalam too.
# VILLAGE_ML_ASR_DIR=models/whisper/ml-asr
# Spoken replies use a local neural voice (Piper). Install it with
# ./scripts/install_piper.sh; the defaults below are what that script writes.
# VILLAGE_PIPER_BIN=models/piper/piper
# VILLAGE_PIPER_VOICES=models/piper/voices
# VILLAGE_PIPER_CACHE=data/cache/tts
VILLAGE_DB_PATH=data/village.db
VILLAGE_BIND_HOST=127.0.0.1
VILLAGE_PORT=8010
VILLAGE_POLL_ENABLED=true
VILLAGE_SAMPLE_LOOP=true

# Optional overrides
# VILLAGE_VENV=/path/to/venv
# VILLAGE_WHISPER_BIN=/path/to/whisper-server
# VILLAGE_DIST_DIR=/path/to/dist

# ---------------------------------------------------------------- vision model ---
# Names the object in a photo.  It is NOT the classifier: this app's classes are
# materials (Glass, Metal, Thermocol) and a vision model names objects ("a
# glass jar"), which measured worse than the local ResNet50 for choosing a bin.
# Used by scripts/waste/label_captures.py and by the waste card's "I see …" line.
#
# provider: opencode (DeepSeek on OpenCode Go) | cloudflare (Workers AI)
VILLAGE_VISION_PROVIDER=opencode
VILLAGE_VISION_BASE_URL=https://opencode.ai/inference/go/v1
VILLAGE_VISION_MODEL=deepseek-v4.1-flash
VILLAGE_VISION_API_KEY=
# Cloudflare Workers AI (free tier): account id + a token with "Workers AI: Read".
#   @cf/meta/llama-3.2-11b-vision-instruct
#   @cf/llava-hf/llava-1.5-7b-hf
#   @cf/unum/uform-gen2-qwen-500m
VILLAGE_CF_ACCOUNT_ID=
VILLAGE_CF_API_TOKEN=
VILLAGE_CF_VISION_MODEL=@cf/meta/llama-3.2-11b-vision-instruct
# A second Cloudflare account (its own daily allowance).  Used automatically
# when the first answers "quota/limit", and the choice is sticky for the rest of
# the session.  Add _3, _4 … the same way.  With every Cloudflare account spent,
# VILLAGE_VISION_API_KEY (DeepSeek on OpenCode Go) is the last resort — slower,
# but an answer instead of "unavailable".
VILLAGE_CF_ACCOUNT_ID_2=
VILLAGE_CF_API_TOKEN_2=
