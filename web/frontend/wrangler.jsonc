{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "village",
  "compatibility_date": "2026-11-08",
  "main": "./worker.js",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  }
}
